<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resources | NewStart</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <p class="brand"><a href="/">NewStart</a></p>
        <h1>Toronto newcomer resources</h1>
        <p>Browse official services or narrow the list with filters.</p>
    </header>
    <main>
        <form class="filter-form" method="get" action="/resources">
            <label for="category">Category</label>
            <select id="category" name="category">
                <option value="">All categories</option>
                <% categories.forEach((category) => { %>
                    <option value="<%= category %>" <%= filters.category === category ? "selected" : "" %>><%= category %></option>
                <% }) %>
            </select>
            <label for="language">Language</label>
            <select id="language" name="language">
                <option value="">All languages</option>
                <% languages.forEach((language) => { %>
                    <option value="<%= language %>" <%= filters.language === language ? "selected" : "" %>><%= language %></option>
                <% }) %>
            </select>
            <label for="area">Area</label>
            <select id="area" name="area">
                <option value="">All areas</option>
                <% areas.forEach((area) => { %>
                    <option value="<%= area %>" <%= filters.area === area ? "selected" : "" %>><%= area %></option>
                <% }) %>
            </select>
            <button type="submit">Apply filters</button>
        </form>

        <p class="results-count"><strong><%= resources.length %></strong> resource(s) found.</p>
        <% if (!resources.length) { %>
            <p class="notice">No resources match those filters. Try changing or clearing a filter.</p>
        <% } %>
        <section class="resource-list">
            <% resources.forEach((resource) => { %>
                <article class="resource-card">
                    <p class="step-label"><%= resource.category %></p>
                    <h2><a href="/resources/<%= resource.id %>"><%= resource.name %></a></h2>
                    <p><%= resource.description %></p>
                    <p><strong>Languages:</strong> <%= resource.languages.join(", ") || "Not available" %></p>
                    <p><strong>Area:</strong> <%= resource.location.municipality %></p>
                    <p><a href="/resources/<%= resource.id %>">View service details</a></p>
                </article>
            <% }) %>
        </section>
    </main>
</body>
</html>
